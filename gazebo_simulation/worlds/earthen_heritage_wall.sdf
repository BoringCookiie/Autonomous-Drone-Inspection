<?xml version="1.0" encoding="UTF-8"?>
<sdf version="1.9">
  <world name="earthen_heritage_wall">
    <physics type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>
    <plugin name="gz::sim::systems::Physics" filename="gz-sim-physics-system"/>
    <plugin name="gz::sim::systems::UserCommands" filename="gz-sim-user-commands-system"/>
    <plugin name="gz::sim::systems::SceneBroadcaster" filename="gz-sim-scene-broadcaster-system"/>
    <plugin name="gz::sim::systems::Contact" filename="gz-sim-contact-system"/>
    <plugin name="gz::sim::systems::Imu" filename="gz-sim-imu-system"/>
    <plugin name="gz::sim::systems::AirPressure" filename="gz-sim-air-pressure-system"/>
    <plugin name="gz::sim::systems::ApplyLinkWrench" filename="gz-sim-apply-link-wrench-system"/>
    <plugin name="gz::sim::systems::NavSat" filename="gz-sim-navsat-system"/>
    <plugin name="gz::sim::systems::Sensors" filename="gz-sim-sensors-system">
      <render_engine>ogre2</render_engine>
    </plugin>

    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>31.6295</latitude_deg>
      <longitude_deg>-7.9811</longitude_deg>
      <elevation>466</elevation>
    </spherical_coordinates>

    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <scene>
      <ambient>0.45 0.40 0.32 1</ambient>
      <background>0.70 0.70 0.70 1</background>
      <shadows>true</shadows>
    </scene>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material>
            <ambient>0.50 0.40 0.28 1</ambient>
            <diffuse>0.55 0.45 0.32 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <light name="sun" type="directional">
      <pose>0 0 500 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <intensity>1</intensity>
      <direction>0.1 0.6 -0.8</direction>
    </light>

    <!-- Inspection facade. The PX4 camera-equipped model is spawned by PX4. -->
    <model name="earthen_heritage_wall">
      <static>true</static>
      <pose>0 5 2 0 0 0</pose>
      <link name="wall_link">
        <collision name="collision">
          <geometry><box><size>10 0.5 4</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>10 0.5 4</size></box></geometry>
          <material>
            <ambient>0.58 0.38 0.20 1</ambient>
            <diffuse>0.66 0.46 0.26 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Thin visual markings provide deterministic simulated defect locations. -->
    <model name="structural_crack_marker">
      <static>true</static>
      <pose>-1.2 4.744 2.1 0 0.15 0</pose>
      <link name="marker_link">
        <visual name="crack">
          <geometry><box><size>0.08 0.012 1.45</size></box></geometry>
          <material><ambient>0.06 0.03 0.015 1</ambient><diffuse>0.08 0.04 0.02 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="surface_erosion_marker">
      <static>true</static>
      <pose>1.8 4.744 1.35 0 0 0</pose>
      <link name="marker_link">
        <visual name="erosion">
          <geometry><box><size>1.0 0.012 0.65</size></box></geometry>
          <material><ambient>0.28 0.16 0.08 1</ambient><diffuse>0.34 0.20 0.10 1</diffuse></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
